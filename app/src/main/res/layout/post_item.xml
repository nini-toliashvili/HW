<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="12dp"
    android:background="@drawable/post_item_shape"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/profile_image"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="25dp"
        android:layout_marginStart="20dp"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:background="@drawable/prof_image_shape"
        android:backgroundTint="#FF565E"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alice Smith"
        android:textSize="12sp"
        android:fontFamily="@font/fira_bold"
        android:layout_marginTop="4dp"
        android:layout_marginStart="15dp"
        android:textColor="@color/white"
        app:layout_constraintTop_toTopOf="@id/profile_image"
        app:layout_constraintStart_toEndOf="@id/profile_image"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/post_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="20 April at 4:20 PM"
        android:textSize="10sp"
        android:fontFamily="@font/fira_light"
        android:layout_marginStart="15dp"
        android:layout_marginBottom="4dp"
        android:textColor="#96A7AF"
        app:layout_constraintBottom_toBottomOf="@id/profile_image"
        app:layout_constraintStart_toEndOf="@id/profile_image"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/post_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="50dp"
        android:layout_marginTop="15dp"
        android:textColor="@color/white"
        android:fontFamily="@font/fira_regular"
        android:textSize="10sp"
        android:lineHeight="14dp"
        android:text="We're interested in your ideas and would be glad to build something bigger out of it."
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profile_image"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/line_bellow_post_content"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="115dp"
        android:background="#607076"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

  <androidx.appcompat.widget.AppCompatTextView
      android:id="@+id/comments_quantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
      android:layout_marginStart="8dp"
        android:text="7 Comments"
        android:textColor="#96A7AF"
        app:layout_constraintStart_toEndOf="@id/comments_icon"
      app:layout_constraintBottom_toBottomOf="@id/comments_icon"/>
    
    
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/comments_icon"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginTop="19dp"
        android:layout_marginStart="20dp"
        android:src="@drawable/messagesquarefill"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/line_bellow_post_content"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/likes_quantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:layout_marginStart="8dp"
        android:text="49 Likes"
        android:textColor="#96A7AF"
        app:layout_constraintStart_toEndOf="@id/likes_icon"
        app:layout_constraintBottom_toBottomOf="@id/comments_icon"/>


    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/likes_icon"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginTop="19dp"
        android:layout_marginStart="20dp"
        android:src="@drawable/heart"
        app:layout_constraintStart_toEndOf="@id/comments_quantity"
        app:layout_constraintTop_toBottomOf="@id/line_bellow_post_content"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/share_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="20dp"
        android:text="Share"
        android:textColor="#96A7AF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/share_icon"
        app:layout_constraintBottom_toBottomOf="@id/comments_icon"/>


    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/share_icon"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginTop="19dp"
        android:layout_marginStart="20dp"
        android:src="@drawable/sharesolid"
        app:layout_constraintStart_toEndOf="@id/likes_quantity"
        app:layout_constraintTop_toBottomOf="@id/line_bellow_post_content"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/line_at_bottom"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="15dp"
        android:background="#607076"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/comments_icon"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/profile_image_at_comments"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:background="@drawable/prof_image_shape"
        android:backgroundTint="#3ED598"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/line_at_bottom"
        app:layout_constraintBottom_toBottomOf="parent"/>
    
    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/comments_et"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginEnd="20dp"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="16dp"
        android:text="Write comment..."
        android:textSize="11sp"
        android:textColor="#96A7AF"
        android:paddingStart="12dp"
        android:background="@drawable/comments_et_shape"
        app:layout_constraintTop_toBottomOf="@id/line_at_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/profile_image_at_comments"
        app:layout_constraintEnd_toEndOf="parent"/>
    
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="11dp"
        android:src="@drawable/paperclip"
        app:layout_constraintTop_toTopOf="@id/comments_et"
        app:layout_constraintEnd_toEndOf="@id/comments_et"
        app:layout_constraintBottom_toBottomOf="@id/comments_et"/>



<!--    case 1 image-->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/one_image_case_image_view"
        android:layout_width="135dp"
        android:layout_height="155dp"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:visibility="invisible"
        android:background="@drawable/image_shape"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/post_text"
        app:layout_constraintBottom_toTopOf="@id/line_bellow_post_content"/>

    <!--    case 2 image-->
<LinearLayout
    android:visibility="invisible"
    android:id="@+id/two_images_case"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:orientation="horizontal"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="15dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toBottomOf="@id/post_text"
    app:layout_constraintBottom_toTopOf="@id/line_bellow_post_content" >

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/two_images_one"
        android:layout_width="135dp"
        android:layout_height="155dp"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:layout_marginEnd="8dp"
        android:background="@drawable/image_shape"
        android:layout_weight = "1"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/two_images_two"
        android:layout_width="135dp"
        android:layout_height="155dp"
        android:clipToOutline="true"
        android:layout_marginStart="8dp"
        android:scaleType="centerCrop"
        android:background="@drawable/image_shape"
        android:layout_weight = "1"/>


</LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/three_images_case"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/post_text"
        app:layout_constraintBottom_toTopOf="@id/line_bellow_post_content">
        
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/three_images_one"
            android:layout_width="135dp"
            android:layout_height="155dp"
            android:background="@drawable/image_shape"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/three_images_two"
            android:layout_width="135dp"
            android:layout_height="72dp"
            android:background="@drawable/image_shape"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/three_images_three"
            android:layout_width="135dp"
            android:layout_height="72dp"
            app:layout_constraintHeight_percent="45"
            app:layout_constraintWidth_percent="45"
            android:background="@drawable/image_shape"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
        
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>