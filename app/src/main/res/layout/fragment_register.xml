<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ellipsetop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ellipsebottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="62dp"
        android:text="Register"
        android:textSize="48sp"
        android:textColor="@color/black"
        android:layout_marginTop="95dp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/registericon"
        android:layout_marginTop="214dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>



    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/input_email"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="475dp"
        android:textSize="25sp"
        android:backgroundTint="#D4B6FA"
        android:textColorHint="#B279F6"
        android:hint="Email"
        android:paddingStart="120dp"
        android:background="@drawable/button_shape"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/email_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="25dp"
        android:src="@drawable/email"
        app:layout_constraintStart_toStartOf="@id/input_email"
        app:layout_constraintTop_toTopOf="@id/input_email"
        app:layout_constraintBottom_toBottomOf="@id/input_email"/>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/username_input_field_login"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="569dp"
        android:textSize="25sp"
        android:backgroundTint="#D4B6FA"
        android:textColorHint="#B279F6"
        android:hint="Username"
        android:paddingStart="120dp"
        android:background="@drawable/button_shape"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginStart="25dp"
        android:src="@drawable/user"
        app:layout_constraintStart_toStartOf="@id/username_input_field_login"
        app:layout_constraintTop_toTopOf="@id/username_input_field_login"
        app:layout_constraintBottom_toBottomOf="@id/username_input_field_login"/>


    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/password_input_field_login"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="663dp"
        android:textSize="25sp"
        android:backgroundTint="#D4B6FA"
        android:textColorHint="#B279F6"
        android:hint="Password"
        android:paddingStart="120dp"
        android:background="@drawable/button_shape"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginStart="25dp"
        android:src="@drawable/locked"
        app:layout_constraintStart_toStartOf="@id/password_input_field_login"
        app:layout_constraintTop_toTopOf="@id/password_input_field_login"
        app:layout_constraintBottom_toBottomOf="@id/password_input_field_login"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginEnd="25dp"
        android:src="@drawable/eyeinvisiblefilled"
        app:layout_constraintEnd_toEndOf="@id/password_input_field_login"
        app:layout_constraintTop_toTopOf="@id/password_input_field_login"
        app:layout_constraintBottom_toBottomOf="@id/password_input_field_login"/>


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/register_button_r"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="780dp"
        android:text="Register"
        android:textColor="@color/white"
        android:textSize="23sp"
        android:textAllCaps="false"
        android:backgroundTint="#700bEF"
        android:background="@drawable/button_shape"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>