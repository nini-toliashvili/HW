<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/remember_me"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Remember me"
        android:textSize="19dp"
        android:textColor="#700bEF"
        app:layout_constraintTop_toBottomOf="@id/login_button_l"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ellipsetop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ellipsebottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="62dp"
        android:text="Login"
        android:textSize="48sp"
        android:textColor="@color/black"
        android:layout_marginTop="95dp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/loginicon"
        android:layout_marginTop="172dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>


    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/username_input_field_login"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="484dp"
        android:textSize="25sp"
        android:backgroundTint="#D4B6FA"
        android:textColorHint="#B279F6"
        android:hint="Username"
        android:paddingStart="120dp"
        android:background="@drawable/button_shape"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginStart="25dp"
        android:src="@drawable/user"
        app:layout_constraintStart_toStartOf="@id/username_input_field_login"
        app:layout_constraintTop_toTopOf="@id/username_input_field_login"
        app:layout_constraintBottom_toBottomOf="@id/username_input_field_login"/>


    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/password_input_field_login"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="580dp"
        android:textSize="25sp"
        android:backgroundTint="#D4B6FA"
        android:textColorHint="#B279F6"
        android:hint="Password"
        android:inputType="textPassword"
        android:paddingStart="120dp"
        android:background="@drawable/button_shape"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginStart="25dp"
        android:src="@drawable/locked"
        app:layout_constraintStart_toStartOf="@id/password_input_field_login"
        app:layout_constraintTop_toTopOf="@id/password_input_field_login"
        app:layout_constraintBottom_toBottomOf="@id/password_input_field_login"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginEnd="25dp"
        android:src="@drawable/eyeinvisiblefilled"
        app:layout_constraintEnd_toEndOf="@id/password_input_field_login"
        app:layout_constraintTop_toTopOf="@id/password_input_field_login"
        app:layout_constraintBottom_toBottomOf="@id/password_input_field_login"/>


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/login_button_l"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="100dp"
        android:text="Login"
        android:textColor="@color/white"
        android:textSize="23sp"
        android:textAllCaps="false"
        android:backgroundTint="#700bEF"
        android:background="@drawable/button_shape"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>