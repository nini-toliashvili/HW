<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    
    <androidx.appcompat.widget.AppCompatImageButton
        android:paddingHorizontal="40dp"
        android:layout_marginHorizontal="30dp"
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="540dp"
        android:elevation="8dp"
        android:background="@drawable/card_shape"
        android:clipToOutline="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

<androidx.appcompat.widget.AppCompatImageView
    android:id="@+id/fire_logo"
    android:layout_width="16dp"
    android:layout_height="16dp"
    android:src="@drawable/fire"
    android:elevation="8dp"
    android:layout_marginTop="50dp"
    android:layout_marginEnd="8dp"
    app:layout_constraintTop_toTopOf="@id/card"
    app:layout_constraintEnd_toStartOf="@id/react_count"/>

  <androidx.appcompat.widget.AppCompatTextView
      android:id="@+id/react_count"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textSize="18sp"
      android:textColor="@color/white"
      android:text="2500"
      android:elevation="8dp"

      android:layout_marginTop="45dp"
      android:layout_marginEnd="30dp"
      app:layout_constraintEnd_toEndOf="@id/card"
      app:layout_constraintTop_toTopOf="@id/card"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/location_logo"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/location__1_"
        android:layout_marginTop="46dp"
        android:layout_marginStart ="30dp"
        android:elevation="8dp"

        app:layout_constraintTop_toTopOf="@id/card"
        app:layout_constraintStart_toStartOf="@+id/card"/>


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/location_name"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:text="Barcelona"
        android:elevation="8dp"

        android:layout_marginStart="8dp"
        android:layout_marginTop="43dp"
        app:layout_constraintStart_toEndOf="@id/location_logo"
        app:layout_constraintTop_toTopOf="@id/card"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="title"
        android:textColor="@color/white"
        android:elevation="8dp"

        android:textSize="35sp"
        android:layout_marginStart="30dp"
        android:layout_marginBottom="110dp"
        app:layout_constraintStart_toStartOf="@id/card"
        app:layout_constraintBottom_toBottomOf="@id/card"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="20dp"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:elevation="8dp"

        android:text="250"
        app:layout_constraintStart_toStartOf="@id/card"
        app:layout_constraintTop_toBottomOf="@id/title"/>

    <RatingBar
        android:id="@+id/rate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="-45dp"
        android:layout_marginBottom="47dp"
        android:numStars="5"
        android:stepSize="0.1"
        android:rating="0.0"
        android:scaleX="0.5"
        android:elevation="8dp"

        android:scaleY="0.5"
        android:isIndicator="true"
        app:layout_constraintEnd_toEndOf="@id/card"
        app:layout_constraintBottom_toBottomOf="@id/card"/>

</androidx.constraintlayout.widget.ConstraintLayout>