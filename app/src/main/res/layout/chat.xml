<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image_v"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="30dp"
        android:clipToOutline="true"
        android:background = "@drawable/button_shape"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

<androidx.appcompat.widget.AppCompatTextView
    android:id="@+id/name_owner"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="grisha oniani"
    android:layout_marginTop="5dp"
    android:textStyle="bold"
    android:textColor="@color/white"
    android:layout_marginStart="20dp"
    android:textSize="18dp"
    app:layout_constraintStart_toEndOf="@id/image_v"
    app:layout_constraintTop_toTopOf="@id/image_v"/>


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/last_message_tv"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="თავის ტერიტორიას ბომბავდა"
        android:layout_marginBottom="5dp"
        android:textStyle="bold"
        android:textColor = "@color/white"
        android:maxLines="1"
        android:layout_marginStart="20dp"
        android:textSize="14dp"
        app:layout_constraintStart_toEndOf="@id/image_v"
        app:layout_constraintBottom_toBottomOf="@id/image_v"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="4:20 PM"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="5dp"
        android:textColor="@color/white"
        android:textSize="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/image_v"/>


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/unread_messages"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3"
        android:layout_marginBottom="5dp"
        android:textColor = "@color/white"
        android:layout_marginEnd="30dp"
        android:textSize="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/image_v"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="105dp"
        android:background="#56666A"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>